# Shioaji API Credentials
# Get these from your broker (Sinopac Securities)
SHIOAJI_API_KEY=your_api_key_here
SHIOAJI_SECRET_KEY=your_secret_key_here

# Trading Permission (default: false for safety)
SHIOAJI_TRADING_ENABLED=false

# HTTP API Configuration (only required for HTTP mode)
# Generate a secure random key: openssl rand -hex 32
HTTP_API_KEY=your_secure_random_api_key_here

# HTTP Server Listen Address (only for HTTP mode)
HTTP_LISTEN_HOST=127.0.0.1
HTTP_LISTEN_PORT=8080

# For Tailscale VPN: use 0.0.0.0 and bind to Tailscale IP via Docker port mapping
# HTTP_LISTEN_HOST=0.0.0.0

# Optional: Set log level
LOG_LEVEL=INFO